{
  "defender-xdr": {
    "type": "stdio",
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server/index.js"],
    "env": {
      "CLAUDE_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
      "CLAUDE_PLUGIN_OPTION_TENANT_ID": "${user_config.tenant_id}",
      "CLAUDE_PLUGIN_OPTION_CLIENT_ID": "${user_config.client_id}",
      "CLAUDE_PLUGIN_OPTION_API_BASE_URL": "${user_config.api_base_url}",
      "CLAUDE_PLUGIN_OPTION_MAXIMUM_ROWS": "${user_config.maximum_rows}",
      "CLAUDE_PLUGIN_OPTION_DEFAULT_LOOKBACK": "${user_config.default_lookback}",
      "CLAUDE_PLUGIN_OPTION_ALLOW_UNENCRYPTED_TOKEN_CACHE": "${user_config.allow_unencrypted_token_cache}"
    }
  }
}
